                    local p=$(echo "$line" | grep -oE 'dport [0-9]+' | awk '{print $2}')
                    
                    [ -z "$h" ] || [ -z "$p" ] && continue

                    local proto="tcp"
                    if echo "$line" | grep -qw "udp"; then proto="udp"; fi
                    
                    local ip_limit="所有 IP"
                    if echo "$line" | grep -q "meta nfproto ipv4" || echo "$line" | grep -q "saddr 0.0.0.0/0"; then
