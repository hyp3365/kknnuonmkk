sing-box添加ipv6隧道作为出站 下列代码添加到出站
{
      "type": "direct",
      "tag": "sit-ipv6-1",
      "bind_interface": "NetAssist",#NetAssist 是ipv6隧道网卡名
      "inet6_bind_address": "2a01:d0:9ccd:cabb:d9e6:fc73:4a3f:b310"
}

sing-box 只允许白名单网站访问 解析dns

{
  "log": {
    "disabled": false,
    "level": "error",
    "output": "/etc/sing-box/sb.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "googleapis.com",
          "gstatic.com",
          "googleusercontent.com",
          "ggpht.com",
          "twitch.tv",
          "youtube.com",
          "youtu.be",
          "googlevideo.com",
          "ytimg.com",
          "youtube-nocookie.com"
        ],
        "server": "local"
      },
      {
        "action": "reject"
      }
    ],
    "final": "local"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "domain_suffix": [
          "googleapis.com",
          "gstatic.com",
          "googleusercontent.com",
          "ggpht.com",
          "twitch.tv",
          "youtube.com",
          "youtu.be",
          "googlevideo.com",
          "ytimg.com",
          "youtube-nocookie.com"
        ],
        "outbound": "direct"
      }
    ],
    "final": "block"
  }
}

